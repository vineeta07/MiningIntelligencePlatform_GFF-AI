# Mining Operation Dashboard - Backend Environment Configuration Example (Render)

APP_NAME="Mining Intelligence Platform API"
API_V1_PREFIX="/api/v1"
DEBUG=False

# Render dynamically passes PORT variable in production

# Database Configuration (PostgreSQL / MongoDB Atlas on Render)
# DATABASE_URL=postgresql://user:password@ep-xyz.postgres.database.azure.com:5432/mining_db
DATABASE_URL=sqlite:///./mining_intelligence.db
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=mining_intel_logs
MONGO_ENABLED=False

# Allowed CORS Origins (Vercel Frontend URL of Dashboard and Safety Blast Checker)
CORS_ORIGINS=["https://mining-dashboard.vercel.app", "https://safety-blast-checker.vercel.app", "http://localhost:5173"]
